{
  "name": "actor-map",
  "version": "0.8.0",
  "description": "通过对话把需求聊定：把产品的角色可操作地图聊成一份带 ✔/⚠ 的断言清单，再用它拦住 PR",
  "type": "module",
  "license": "MIT",
  "bin": {
    "actormap": "./dist/cli.js",
    "actor-map": "./dist/cli.js"
  },
  "files": [
    "action.yml",
    "src/",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "examples/expense/ir.json",
    "examples/expense/adapters/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"tests/*.test.ts\"",
    "demo": "node src/cli.ts report --ir examples/expense/ir.json",
    "demo:map": "node src/cli.ts render --ir examples/expense/ir.json --out examples/expense/map.html",
    "validate": "node src/cli.ts validate",
    "prepublishOnly": "npm run build && npm test",
    "start": "node src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eust-w/actor-map.git"
  },
  "homepage": "https://github.com/eust-w/actor-map#readme",
  "bugs": {
    "url": "https://github.com/eust-w/actor-map/issues"
  },
  "keywords": [
    "requirements",
    "state-machine",
    "pi-extension",
    "product-management",
    "agent",
    "github-action",
    "code-review",
    "conformance-testing"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
